    {
      "name": "GATE private beta",
      "description": "Agent-first HTTP 402 authorization. Merchant receives sats directly. Credits are consumed only after verified authorization. Not x402 compatibility.",
      "item": [
        {
          "name": "GATE native quote",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{gateProjectKey}}",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{gateIdempotencyKey}}",
                "type": "text"
              },
              {
                "key": "X-Gate-Project",
                "value": "{{gateProjectId}}",
                "type": "text"
              },
              {
                "key": "X-Gate-Route",
                "value": "{{gateRouteKey}}",
                "type": "text"
              },
              {
                "key": "X-Gate-Method",
                "value": "POST",
                "type": "text"
              },
              {
                "key": "X-Gate-Path",
                "value": "/v1/weather",
                "type": "text"
              },
              {
                "key": "Content-Type",
