{
  "name": "the402machine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted Lightning-powered vending machine for tiny disposable Internet appliances.",
  "license": "ISC",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "migrate": "node scripts/migrate.mjs",
    "gate:operator": "tsx src/gate/gate-operator-cli.ts",
    "worker": "node dist/worker.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build:qr": "esbuild public/assets/qr.js --bundle --format=esm --platform=browser --target=es2020 --minify --outfile=public/assets/qr-browser-v3.js",
    "build:webln": "esbuild public/assets/webln-entry.js --bundle --format=esm --platform=browser --target=es2020 --minify --outfile=public/assets/webln-browser.js",
    "build:browser": "npm run build:qr && npm run build:webln"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/static": "^10.1.8",
    "@unional/macaroon": "^3.2.1",
    "bolt11-ts": "^0.2.1",
    "fast-geoip": "1.1.88",
    "fastify": "5.12.7",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "undici": "^7.30.1",
    "webln": "^0.3.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "fake-bolt11": "^0.1.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
